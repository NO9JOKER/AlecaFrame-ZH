{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modules.schema.json",
  "title": "src/runtime/modules.json",
  "description": "运行时模块装配清单：顺序、依赖、层与风险",
  "type": "object",
  "required": ["schemaVersion", "modules"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "required": ["id", "file", "layer", "deps", "risk"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$" },
        "file": { "type": "string", "pattern": "\\.js$" },
        "layer": {
          "type": "string",
          "enum": ["core", "rules", "dom", "features", "adapters", "entry"]
        },
        "deps": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$" }
        },
        "risk": { "type": "string", "enum": ["T1", "T2"] },
        "notes": { "type": "string" }
      }
    }
  }
}
