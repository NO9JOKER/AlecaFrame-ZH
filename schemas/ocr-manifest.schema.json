{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocr-manifest.schema.json",
  "title": "src/ocr/manifest.json",
  "description": "OCR 子系统注册表：页面脚本、server、worker、端口与硬契约",
  "type": "object",
  "required": ["schemaVersion", "status", "server", "runtimeDir", "generatedItems", "pageScripts", "globals", "prerequisites"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "status": { "type": "string", "enum": ["planned", "active", "frozen"] },
    "server": {
      "type": "object",
      "required": ["entry", "port"],
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "string", "pattern": "\\.js$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "runtimeDir": { "type": "string", "minLength": 1 },
    "generatedItems": { "type": "string", "minLength": 1 },
    "pageScripts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "deployName", "pages", "purpose"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "source": { "type": "string", "pattern": "\\.js$" },
          "deployName": { "type": "string", "pattern": "^afzh-[a-z0-9-]+\\.js$" },
          "pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "globals": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^__[A-Za-z0-9_]+__$" }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
